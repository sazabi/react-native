{
  "name": "@sazabi/react-native",
  "description": "Sazabi React Native observability SDK — semantic event stream capture with W3C trace context propagation",
  "version": "0.1.1",
  "keywords": [
    "sazabi",
    "react-native",
    "expo",
    "observability",
    "monitoring",
    "logging",
    "error-tracking",
    "crash-reporting",
    "opentelemetry",
    "otlp",
    "tracing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./dist/register.js": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "react-native": {
    "./register": "./dist/register.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/sazabi/react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sazabi/react-native.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
